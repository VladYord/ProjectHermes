# Hermes — Environment Variables
# Copy this file to .env and fill in your values.
# Only needed if using cloud LLM providers.

# OpenAI (optional — only if using OpenAI provider)
OPENAI_API_KEY=

# Google Gemini (optional — only if using Gemini provider)
GEMINI_API_KEY=

# Server auth (optional — only if exposing to network)
HERMES_API_KEY=
